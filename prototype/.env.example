# Configuracion de MotelOS (prototipo v3). Copiar a .env: cp .env.example .env
# El archivo .env no se versiona. Todos los valores de este ejemplo son de demostracion: ninguno es una credencial real.

# --- Base de datos -----------------------------------------------------------------------------------------------
# Usuario duenio de las tablas: aplica las migraciones y carga los datos de demostracion. La API no lo usa.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=motel_db
# Rol de la aplicacion, sin propiedad de las tablas (lo crea la migracion 001 con la clave motel_app).
APP_DB_USER=motel_app
APP_DB_PASSWORD=motel_app
# Solo para correr la API fuera de Docker; docker-compose.yml arma esta direccion con las variables de arriba.
DATABASE_URL=postgresql+asyncpg://motel_app:motel_app@db:5432/motel_db
SQL_ECHO=False

# --- Puertos publicados (solo en 127.0.0.1) ----------------------------------------------------------------------
# Si alguno esta ocupado, cambiarlo aca y ajustar VITE_API_URL y CORS_ORIGINS al puerto nuevo.
DB_PORT=5432
API_PORT=8000
WEB_PORT=5173
VITE_API_URL=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:5173

# --- Sesion (RNF-04) ---------------------------------------------------------------------------------------------
# En produccion: ENTORNO=produccion, COOKIE_SECURE=True y un JWT_SECRET propio de 32 o mas caracteres, por ejemplo:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
ENTORNO=desarrollo
JWT_SECRET=solo-para-desarrollo-local-no-usar-en-produccion
COOKIE_SECURE=False

# --- Operacion ---------------------------------------------------------------------------------------------------
# Fondo de cambio de respaldo, en pesos. El vigente vive en la base (migracion 005) y lo cambia la gerencia.
FONDO_INICIAL_CAJA=25000
# Direccion de la ventanilla en la red del motel, para el QR de los comprobantes y del cliente. Vacia: la primera
# de CORS_ORIGINS. Ejemplo para un celular en el mismo Wi-Fi: http://192.168.0.10:5173
URL_PUBLICA=
# Recuento de toallas y sabanas obligatorio al abrir y cerrar una guardia (migracion 016).
EXIGIR_RECUENTO_ROPA=True

# --- Usuarios de demostracion ------------------------------------------------------------------------------------
# Los crea `docker compose --profile admin run --rm admin`: gerencia, conserje1 y conserje2 en los establecimientos
# motelcc y luna, y el usuario plataforma. Son claves de prueba de este ejemplo; si se dejan vacias se generan al azar
# y se muestran una sola vez en la consola. Cambiarlas antes de usar el sistema con datos reales.
DEMO_CLAVE_GERENCIA=demo-gerencia-2026
DEMO_CLAVE_CONSERJES=demo-conserje-2026
DEMO_CLAVE_PLATAFORMA=demo-plataforma-2026

# --- Parametros con valor por defecto (backend/app/core/config.py); descomentar solo para cambiarlos ---------------
# SESION_HORAS=9
# LOGIN_MAX_INTENTOS=5
# LOGIN_BLOQUEO_MIN=15
# ZONA_HORARIA=America/Argentina/Buenos_Aires
# GUARDIA_ANTICIPACION_MIN=120
# RETENCION_PATENTE_HORAS=24
# DEPURACION_INTERVALO_MIN=60
# ESTABLECIMIENTO_PREDETERMINADO=motelcc
# ARGON2_TIME_COST=3
# ARGON2_MEMORY_KIB=65536

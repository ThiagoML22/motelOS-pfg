POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=motel_db
APP_DB_USER=motel_app
APP_DB_PASSWORD=motel_app
DATABASE_URL=postgresql+asyncpg://motel_app:motel_app@db:5432/motel_db
VITE_API_URL=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:5173
SQL_ECHO=False

# Sesion (RNF-04). En produccion: ENTORNO=produccion, COOKIE_SECURE=True y un JWT_SECRET propio de 32 o mas
# caracteres, por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(48))"
ENTORNO=desarrollo
JWT_SECRET=solo-para-desarrollo-local-no-usar-en-produccion
COOKIE_SECURE=False

# Fondo de cambio de cada caja, en pesos (aprobado por la gerencia en el acta del 19/10/2026).
FONDO_INICIAL_CAJA=25000

# Claves de los operadores de demostracion (docker compose run --rm admin). Si quedan vacias se generan
# al azar y se muestran una sola vez.
DEMO_CLAVE_GERENCIA=
DEMO_CLAVE_CONSERJES=
